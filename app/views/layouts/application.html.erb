<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "The Givingguide" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= render "shared/head_assets" %>

    <!-- App styles -->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>

  <body class="bg-light min-vh-100 d-flex flex-column">
    <%= render "shared/navbar" %>

    <%# <% if Rails.env.development? %>
    <%#   <div style="color: red; text-align: center; padding: 0.5rem; background: #fff3cd;">
    <%#     DEV ENVIRONMENT
    <%#   </div>
    <%# <% end %>

    <div id="flash-overlay" style="position: fixed; top: 1rem; left: 50%; transform: translateX(-50%); z-index: 1050; width: auto; max-width: 90%;">
      <% flash.each do |key, message| %>
        <div
          class="alert alert-<%= key == "notice" ? "success" : "danger" %> alert-dismissible fade show text-center shadow"
          role="alert"
          data-controller="flash"
          data-flash-timeout-value="3000">
          <%= message %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
    </div>

    <main class="flex-grow-1 d-flex flex-column">
      <%= yield %>
    </main>

    <%= render "shared/foot_assets" %>
  </body>
</html>
