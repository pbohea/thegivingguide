<% content_for :title, "My Dashboard - The Givingguide" %>

<style>
  .dashboard-header {
    background: linear-gradient(135deg, #2d6a4f 0%, #1b4332 100%);
    color: white;
    padding: 3rem 0;
    margin-bottom: 3rem;
  }

  .dashboard-title {
    font-size: 2.5rem;
    font-weight: 700;
  }

  .dashboard-card {
    background: white;
    border-radius: 15px;
    padding: 2rem;
    box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    margin-bottom: 2rem;
  }

  .card-title {
    color: #2d6a4f;
    font-weight: 600;
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    color: #999;
  }

  .empty-state-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
</style>

<div class="dashboard-header">
  <div class="container">
    <h1 class="dashboard-title">Welcome back, <%= @user.email.split('@').first.capitalize %>!</h1>
    <p>Manage your consultation requests and experiences</p>
  </div>
</div>

<div class="container">
  <div class="row">
    <div class="col-lg-6">
      <div class="dashboard-card">
        <h2 class="card-title">Recent Consultation Requests</h2>
        <% if @consultation_requests.any? %>
          <div class="list-group">
            <% @consultation_requests.each do |request| %>
              <div class="list-group-item">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <h6 class="mb-1"><%= request.name %></h6>
                    <p class="mb-1 text-muted small">
                      <%= truncate(request.message, length: 100) %>
                    </p>
                    <small class="text-muted">
                      Submitted <%= time_ago_in_words(request.created_at) %> ago
                    </small>
                  </div>
                  <% if request.status.present? %>
                    <span class="badge bg-<%= request.status == 'completed' ? 'success' : 'warning' %>">
                      <%= request.status.titleize %>
                    </span>
                  <% else %>
                    <span class="badge bg-secondary">Pending</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
          <div class="text-center mt-3">
            <%= link_to "Request Another Consultation", new_consultation_request_path, class: "btn btn-outline-primary" %>
          </div>
        <% else %>
          <div class="empty-state">
            <div class="empty-state-icon">📝</div>
            <p>You haven't requested any consultations yet</p>
            <%= link_to "Request a Consultation", new_consultation_request_path, class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="dashboard-card">
        <h2 class="card-title">Your Experiences</h2>
        <% if @experiences.any? %>
          <div class="list-group">
            <% @experiences.each do |experience| %>
              <div class="list-group-item">
                <p class="mb-1"><%= truncate(experience.content, length: 150) %></p>
                <small class="text-muted">
                  Shared <%= time_ago_in_words(experience.created_at) %> ago
                  <% if experience.product %>
                    for <%= link_to experience.product.name, product_path(experience.product) %>
                  <% elsif experience.gift_guide %>
                    for <%= link_to experience.gift_guide.name, gift_guide_path(experience.gift_guide) %>
                  <% end %>
                </small>
              </div>
            <% end %>
          </div>
          <div class="text-center mt-3">
            <%= link_to "Share Another Experience", new_experience_path, class: "btn btn-outline-primary" %>
          </div>
        <% else %>
          <div class="empty-state">
            <div class="empty-state-icon">✨</div>
            <p>You haven't shared any experiences yet</p>
            <%= link_to "Share an Experience", new_experience_path, class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
