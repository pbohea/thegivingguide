<div class="container my-5 pt-2">
  <!-- Hero Section -->
  <div class="hero-section text-center">
    <div class="container px-3 px-md-4 py-4 py-md-5">
      <h1 class="display-6 display-md-4 fw-bold mb-2 mb-md-3">About BarChord</h1>
      <p class="lead fs-5 fs-md-4 mb-0">
        Discover live music happening around you
      </p>
    </div>
  </div>

  <!-- Main Description -->
  <div class="row mb-5">
    <div class="col-lg-8 mx-auto text-center">
      <p class="fs-5 text-muted mb-4">
        BarChord puts nearby venues and live events on a map, so you can find great music without the guesswork.
      </p>
      <p class="fs-5 text-muted">
        Artists and venues can create profiles, post events, and grow their audience. Fans can follow favorites and stay in the loop.
      </p>
    </div>
  </div>

  <!-- Feature Cards -->
  <div class="row g-4 mb-5">
    <div class="col-md-4">
      <div class="feature-card shadow-sm">
        <h4 class="fw-bold mb-3">For Fans</h4>
        <p class="text-muted mb-0">
          Sign up to follow your favorite artists and venues. Get notified when they post new shows and never miss a performance.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="feature-card shadow-sm">
        <h4 class="fw-bold mb-3">For Venues</h4>
        <p class="text-muted mb-3">
          Bring in more traffic when you hire live performers. Showcase your space and attract music lovers.
        </p>
        <%= link_to "Learn More", owners_about_path, class: "btn btn-outline-primary btn-modern" %>
      </div>
    </div>

    <div class="col-md-4">
      <div class="feature-card shadow-sm">
        <h4 class="fw-bold mb-3">For Artists</h4>
        <p class="text-muted mb-3">
          Promote your shows and connect with fans. Build your following and grow your audience.
        </p>
        <%= link_to "Learn More", artists_about_path, class: "btn btn-outline-primary btn-modern" %>
      </div>
    </div>
  </div>

  <!-- CTA Section -->
  <div class="cta-section text-center">
    <h3 class="fw-bold mb-3">Ready to discover live music?</h3>
    <p class="text-muted mb-4">Join BarChord today and never miss a show</p>
    <%= link_to "Sign Up Now", menu_path, class: "btn btn-primary btn-modern btn-lg" %>
  </div>
</div>

<style>
  .hero-section {
    background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
    color: white;
    padding: .25rem 0;
    border-radius: 1rem;
    margin-bottom: 3rem;
  }
  
  .feature-card {
    border: none;
    border-radius: 1rem;
    padding: 2rem;
    height: 100%;
    transition: transform 0.2s, box-shadow 0.2s;
    background: white;
    border-left: 4px solid #0d6efd;
  }
  
  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(13, 110, 253, 0.15);
  }
  
  .cta-section {
    background: linear-gradient(135deg, #e7f1ff 0%, #cfe2ff 100%);
    border-radius: 1rem;
    padding: 3rem;
    margin-top: 3rem;
  }
  
  .btn-modern {
    padding: 0.75rem 2rem;
    border-radius: 2rem;
    font-weight: 500;
    transition: all 0.2s;
  }
  
  .btn-modern:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
  }
</style>
