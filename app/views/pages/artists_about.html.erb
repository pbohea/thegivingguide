<div class="container my-5 pt-2">
  <!-- Hero Section -->
  <div class="hero-section text-center">
    <div class="container px-3 px-md-4 py-4 py-md-5">
      <h1 class="display-6 display-md-4 fw-bold mb-2 mb-md-3">For Artists</h1>
      <p class="lead fs-5 fs-md-4 mb-0">
        Share your music, get discovered, and grow your fanbase
      </p>
    </div>
  </div>

  <!-- Feature Cards -->
  <div class="row g-4 mb-5">
    <div class="col-md-6">
      <div class="feature-card shadow-sm">
        <h4 class="fw-bold mb-3">Get Started</h4>
        <p class="text-muted mb-0">
          Sign up as an artist to create your profile, post upcoming shows, and appear on the live music map.
        </p>
      </div>
    </div>

    <div class="col-md-6">
      <div class="feature-card shadow-sm">
        <h4 class="fw-bold mb-3">Post Your Events</h4>
        <p class="text-muted mb-0">
          Once you're signed in, head to your dashboard to post an event. Add the date, time, venue, genre, and more. 
          If you're playing at a venue that's already on BarChord, the owner can also create the event and tag you.
        </p>
      </div>
    </div>

    <div class="col-md-6">
      <div class="feature-card shadow-sm">
        <h4 class="fw-bold mb-3">Get Followed</h4>
        <p class="text-muted mb-0">
          Fans can follow you to keep track of your upcoming performances. They'll receive personalized notifications when you announce new shows.
        </p>
      </div>
    </div>

    <div class="col-md-6">
      <div class="feature-card shadow-sm">
        <h4 class="fw-bold mb-3">Boost Your Reach</h4>
        <p class="text-muted mb-0">
          Add your social media links to your artist profile to make it easy for fans to explore your music and follow you beyond the app.
        </p>
      </div>
    </div>
  </div>

  <!-- CTA Section -->
  <div class="cta-section text-center">
    <h3 class="fw-bold mb-3">Ready to grow your fanbase?</h3>
    <p class="text-muted mb-4">Join BarChord and start sharing your music with fans</p>
    <%= link_to "Sign Up as an Artist", new_artist_registration_path, class: "btn btn-primary btn-modern btn-lg" %>
  </div>
</div>

<style>
  .hero-section {
    background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
    color: white;
    padding: .25rem 0;
    border-radius: 1rem;
    margin-bottom: 3rem;
  }
  
  .feature-card {
    border: none;
    border-radius: 1rem;
    padding: 2rem;
    height: 100%;
    transition: transform 0.2s, box-shadow 0.2s;
    background: white;
    border-left: 4px solid #0d6efd;
  }
  
  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(13, 110, 253, 0.15);
  }
  
  .feature-card h4 {
    color: #0d6efd;
  }
  
  .cta-section {
    background: linear-gradient(135deg, #e7f1ff 0%, #cfe2ff 100%);
    border-radius: 1rem;
    padding: 3rem;
    margin-top: 3rem;
  }
  
  .btn-modern {
    padding: 0.75rem 2rem;
    border-radius: 2rem;
    font-weight: 500;
    transition: all 0.2s;
  }
  
  .btn-modern:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(13, 110, 253, 0.3);
  }
</style>
