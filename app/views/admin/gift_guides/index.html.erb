<% content_for :title, "Manage Posts" %>

<style>
  .admin-header {
    background: linear-gradient(135deg, #1b4332 0%, #2d6a4f 100%);
    color: white;
    padding: 2rem 0;
    margin-bottom: 3rem;
  }

  .post-card {
    background: white;
    border-radius: 15px;
    padding: 1.5rem;
    box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    margin-bottom: 2rem;
  }

  .post-image {
    width: 100%;
    height: 300px;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 1rem;
  }

  .post-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
  }
</style>

<div class="admin-header">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center">
      <div>
        <h1>Manage Posts</h1>
        <p>Instagram-style feed management</p>
      </div>
      <%= link_to "Create New Post", new_admin_gift_guide_path, class: "btn btn-light btn-lg" %>
    </div>
  </div>
</div>

<div class="container">
  <%= link_to "← Back to Dashboard", admin_root_path, class: "btn btn-outline-secondary mb-4" %>

  <% if @gift_guides.any? %>
    <div class="row">
      <% @gift_guides.each do |guide| %>
        <div class="col-md-4">
          <div class="post-card">
            <% if guide.image.attached? %>
              <%= image_tag guide.image, class: "post-image", alt: guide.caption %>
            <% else %>
              <div class="post-image bg-light d-flex align-items-center justify-content-center">
                <span style="font-size: 3rem;">📷</span>
              </div>
            <% end %>

            <p class="mb-2"><strong>Position:</strong> <%= guide.position %></p>
            <p><%= truncate(guide.caption, length: 100) %></p>

            <% if guide.occasion %>
              <span class="badge bg-success"><%= guide.occasion.name %></span>
            <% end %>

            <div class="post-actions">
              <%= link_to "Edit", edit_admin_gift_guide_path(guide), class: "btn btn-sm btn-primary" %>
              <%= button_to "Delete", admin_gift_guide_path(guide),
                  method: :delete,
                  data: { turbo_confirm: "Are you sure you want to delete this post?" },
                  class: "btn btn-sm btn-danger" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-5">
      <h3>No posts yet</h3>
      <p class="text-muted">Create your first Instagram-style post!</p>
      <%= link_to "Create Post", new_admin_gift_guide_path, class: "btn btn-primary mt-3" %>
    </div>
  <% end %>
</div>
