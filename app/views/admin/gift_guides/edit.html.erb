<% content_for :title, "Edit Post" %>

<style>
  .admin-header {
    background: linear-gradient(135deg, #1b4332 0%, #2d6a4f 100%);
    color: white;
    padding: 2rem 0;
    margin-bottom: 3rem;
  }

  .form-card {
    background: white;
    border-radius: 15px;
    padding: 2.5rem;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    max-width: 700px;
    margin: 0 auto;
  }

  .current-image {
    max-width: 100%;
    max-height: 300px;
    border-radius: 10px;
    margin-bottom: 1rem;
  }

  .image-preview {
    max-width: 100%;
    max-height: 400px;
    border-radius: 10px;
    margin-top: 1rem;
  }
</style>

<div class="admin-header">
  <div class="container">
    <h1>Edit Post</h1>
  </div>
</div>

<div class="container">
  <%= link_to "← Back to Posts", admin_gift_guides_path, class: "btn btn-outline-secondary mb-4" %>

  <div class="form-card">
    <%= form_with model: [:admin, @gift_guide], local: true do |f| %>
      <% if @gift_guide.errors.any? %>
        <div class="alert alert-danger">
          <h4>Please fix the following errors:</h4>
          <ul>
            <% @gift_guide.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="mb-3">
        <label class="form-label">Current Image</label>
        <% if @gift_guide.image.attached? %>
          <%= image_tag @gift_guide.image, class: "current-image", alt: @gift_guide.caption %>
        <% end %>
      </div>

      <div class="mb-3">
        <%= f.label :image, "Change Image (optional)", class: "form-label" %>
        <%= f.file_field :image,
            class: "form-control",
            accept: "image/*",
            onchange: "previewImage(event)" %>
        <small class="text-muted">Leave blank to keep current image</small>
        <div id="image-preview"></div>
      </div>

      <div class="mb-3">
        <%= f.label :caption, "Caption *", class: "form-label" %>
        <%= f.text_area :caption,
            class: "form-control",
            rows: 4,
            required: true %>
      </div>

      <div class="mb-3">
        <%= f.label :occasion_id, "Occasion (optional)", class: "form-label" %>
        <%= f.select :occasion_id,
            options_from_collection_for_select(@occasions, :id, :name, @gift_guide.occasion_id),
            { include_blank: "None" },
            class: "form-select" %>
      </div>

      <div class="mb-3">
        <%= f.label :position, "Position (order in feed)", class: "form-label" %>
        <%= f.number_field :position, class: "form-control" %>
        <small class="text-muted">Lower numbers appear first</small>
      </div>

      <%= f.submit "Update Post", class: "btn btn-primary btn-lg w-100" %>
    <% end %>
  </div>
</div>

<script>
function previewImage(event) {
  const file = event.target.files[0];
  const preview = document.getElementById('image-preview');

  if (file) {
    const reader = new FileReader();
    reader.onload = function(e) {
      preview.innerHTML = `<img src="${e.target.result}" class="image-preview" alt="Preview">`;
    }
    reader.readAsDataURL(file);
  }
}
</script>
